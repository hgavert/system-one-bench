# Reference LLM for the Finnish test: Qwen 3.8 27B on Leviathan (vLLM, OpenAI-compatible)
LEVIATHAN_BASE_URL=https://your-vllm-host/v1/
LEVIATHAN_MODEL=qwen3.8-27b
# the key itself stays in the shell environment (OLLAMA_KEY, although the server is vLLM); python-dotenv expands it
LEVIATHAN_API_KEY=${OLLAMA_KEY}
# Hosted Jev (TypeSafe AI), for docs/6-jev.md
JEV_API_KEY=
