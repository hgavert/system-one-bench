.venv/
__pycache__/
.DS_Store

# models and third-party engines: fetched by scripts/download_models.py and scripts/setup_engines.sh
models/
third_party/

# local tool config and run logs (logs contain local paths)
.claude/
results/logs/
results/snake/*.log

# TweetEval tweet text is not redistributed (license "unknown", X terms): regenerate with
# adapters/export_test_tweets.py and 06_export_kev_data.py; results reference tweets by id and row
data/
results/kev-finetune/

# per-move Snake game logs (regenerated by 09_snake_benchmark.py); summaries and probes are kept
results/snake/games/

# local endpoints and keys (see .env.example)
.env

# vision Snake: per-move game logs (regenerated by 15_vision_snake.py; SUMMARY.md is kept), server logs and pid
results/vision_snake/games/
results/vision_snake/*.log
results/vision_snake/*.pid
